<%- include('partials/header') %>
<div class="card medium">
  <h1><%= t('Company registration') %></h1>
  <p class="muted"><%= t('Register once. After admin verification your demands become visible to workers.') %></p>
  <% if (locals.error) { %><div class="alert alert-error"><%= t(error) %></div><% } %>
  <form method="post" action="/register/company" enctype="multipart/form-data">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <fieldset><legend><%= t('Company details') %></legend><%- include('partials/company-fields') %>
      <label><%= t('Company logo (optional)') %> <input type="file" name="logo" accept="image/png,image/jpeg,image/webp">
        <span class="hint"><%= t('JPG, PNG or WEBP, max 2 MB. Shown on your job demands.') %></span></label>
    </fieldset>
    <%- include('partials/account-fields') %>
    <%- include('partials/notify-field') %>
    <button class="btn full"><%= t('Register company') %></button>
  </form>
</div>
<%- include('partials/footer') %>
