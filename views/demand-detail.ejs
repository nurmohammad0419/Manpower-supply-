<%- include('partials/header') %>
<% const req = demand.required_docs ? demand.required_docs.split(',').filter(Boolean) : []; %>
<div class="crumbs"><a href="/demands"><span class="arr">←</span> <%= t('All demands') %></a></div>
<div class="detail">
  <div class="card">
    <span class="tag"><%= t(demand.category) %></span>
    <% if (demand.status !== 'open') { %><span class="badge badge-rejected"><%= t('Closed') %></span><% } %>
    <h1><bdi><%= demand.title %></bdi></h1>
    <p class="muted company-line"><%- include('partials/logo', { file: demand.logo_file }) %><bdi><%= demand.company_name %></bdi> · <%= t(demand.location_city) %><% if (demand.work_site) { %> — <bdi><%= demand.work_site %></bdi><% } %></p>
    <div class="rate big"><strong><%= demand.salary_amount %> <%= t('SAR') %></strong> <%= t(SALARY_TYPES[demand.salary_type]) %></div>

    <table class="kv">
      <tr><th><%= t('Workers needed') %></th><td><%= demand.quantity %> <span class="muted">(<%= t('{n} hired', { n: demand.hired_count }) %>)</span></td></tr>
      <tr><th><%= t('Working hours') %></th><td><%= t('{h} hours/day, {d} days/week', { h: demand.hours_per_day, d: demand.days_per_week }) %></td></tr>
      <tr><th><%= t('Overtime') %></th><td><bdi><%= demand.overtime || '—' %></bdi></td></tr>
      <tr><th><%= t('Contract duration') %></th><td><bdi><%= demand.duration %></bdi></td></tr>
      <tr><th><%= t('Food') %></th><td><%= yesNo(demand.food) %></td></tr>
      <tr><th><%= t('Accommodation') %></th><td><%= yesNo(demand.accommodation) %></td></tr>
      <tr><th><%= t('Transport') %></th><td><%= yesNo(demand.transport) %></td></tr>
      <tr><th><%= t('Start date') %></th><td><%= demand.start_date ? fmtDate(demand.start_date) : t('Immediate') %></td></tr>
      <tr><th><%= t('Apply before') %></th><td><%= demand.deadline ? fmtDate(demand.deadline) : t('Until filled') %></td></tr>
    </table>
    <% if (demand.requirements) { %>
      <h3><%= t('Requirements & details') %></h3>
      <p class="prewrap" dir="auto"><bdi><%= demand.requirements %></bdi></p>
    <% } %>
    <h3><%= t('Documents required') %></h3>
    <ul class="doclist">
      <% req.forEach(d => { %><li><%= t(DOC_TYPES[d]) %></li><% }) %>
      <% if (!req.length) { %><li class="muted"><%= t('No specific documents') %></li><% } %>
    </ul>
    <p><a href="/demands/<%= demand.id %>/letter" target="_blank"><%= t('View printable demand letter') %> ↗</a></p>
  </div>

  <aside class="card apply-box">
    <% if (isOwner) { %>
      <h2><%= t('Your demand') %></h2>
      <p><%= t('{n} applicant(s)', { n: demand.applicant_count }) %></p>
      <a class="btn full" href="/company/demands/<%= demand.id %>"><%= t('Manage applicants') %></a>
    <% } else if (!user) { %>
      <h2><%= t('Apply for this job') %></h2>
      <p class="muted"><%= t('Log in or register as a worker to apply.') %></p>
      <a class="btn full" href="/login?next=/demands/<%= demand.id %>"><%= t('Login to apply') %></a>
      <a class="btn btn-alt full" href="/register/worker"><%= t('Register as worker') %></a>
    <% } else if (user.role !== 'worker') { %>
      <p class="muted"><%= t('Only worker accounts can apply.') %></p>
    <% } else if (application && application.status !== 'withdrawn') { %>
      <h2><%= t('You applied') %></h2>
      <p><%= t('Status') %>: <span class="badge badge-<%= application.status %>"><%= t(APP_STATUS[application.status]) %></span></p>
      <% if (application.company_note) { %><p class="muted"><%= t('Company note') %>: <bdi><%= application.company_note %></bdi></p><% } %>
      <a class="btn btn-alt full" href="/worker"><%= t('Go to my applications') %></a>
    <% } else if (demand.status !== 'open') { %>
      <p class="muted"><%= t('This demand is closed.') %></p>
    <% } else { %>
      <h2><%= t('Apply for this job') %></h2>
      <form method="post" action="/demands/<%= demand.id %>/apply" enctype="multipart/form-data">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <p class="small muted"><%= t('Required documents') %>:</p>
        <% req.forEach(d => { const has = workerDocTypes.includes(d); %>
          <div class="docreq <%= has ? 'ok' : 'missing' %>">
            <div><%= has ? '✓' : '!' %> <%= t(DOC_TYPES[d]) %> <span class="small muted">(<%= has ? t('from your profile') : t('please upload') %>)</span></div>
            <% if (!has) { %><input type="file" name="doc_<%= d %>" accept=".pdf,image/*" required><% } %>
          </div>
        <% }) %>
        <label><%= t('Message to company (optional)') %>
          <textarea name="cover_note" rows="3" maxlength="1000" placeholder="<%= t('e.g. I have 5 years experience, transferable Iqama, available immediately') %>"></textarea>
        </label>
        <button class="btn full"><%= t('Submit application') %></button>
      </form>
    <% } %>
  </aside>
</div>
<%- include('partials/footer') %>
