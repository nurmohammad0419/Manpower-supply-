<fieldset>
  <legend><%= t('Login details') %></legend>
  <div class="row2">
    <label><%= t('Email') %> * <input type="email" name="email" required value="<%= form.email || '' %>" autocomplete="email" dir="ltr"></label>
    <label><%= t('Phone (WhatsApp)') %> * <input type="tel" name="phone" required value="<%= form.phone || '' %>" placeholder="+966 5x xxx xxxx" dir="ltr"></label>
  </div>
  <div class="row2">
    <label><%= t('Password') %> * <input type="password" name="password" required minlength="6" autocomplete="new-password" dir="ltr"></label>
    <label><%= t('Confirm password') %> * <input type="password" name="password_confirm" required minlength="6" autocomplete="new-password" dir="ltr"></label>
  </div>
</fieldset>
