<!doctype html>
<html lang="<%= lang %>" dir="<%= dir %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= t(title) %> · ManpowerHub KSA</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<header class="topbar">
  <div class="wrap topbar-inner">
    <a class="brand" href="/"><span class="logo">MH</span> ManpowerHub <small>KSA</small></a>
    <nav class="nav">
      <a href="/demands" class="<%= path.startsWith('/demands') ? 'active' : '' %>"><%= t('Job Demands') %></a>
      <% if (!user) { %>
        <a href="/login"><%= t('Login') %></a>
        <a class="btn btn-sm" href="/register"><%= t('Register') %></a>
      <% } else { %>
        <% if (user.role === 'company') { %>
          <a href="/company" class="<%= path === '/company' ? 'active' : '' %>"><%= t('Dashboard') %></a>
          <a href="/company/demands/new"><%= t('+ Post Demand') %></a>
          <a href="/company/timesheets" class="<%= path.startsWith('/company/timesheets') ? 'active' : '' %>"><%= t('Timesheets') %></a>
          <a href="/company/profile"><%= t('Profile') %></a>
        <% } else if (user.role === 'worker') { %>
          <a href="/worker" class="<%= path === '/worker' ? 'active' : '' %>"><%= t('My Applications') %></a>
          <a href="/worker/documents"><%= t('Documents') %></a>
          <a href="/worker/payments" class="<%= path === '/worker/payments' ? 'active' : '' %>"><%= t('Payments') %></a>
          <a href="/worker/profile"><%= t('Profile') %></a>
        <% } else { %>
          <a href="/admin"><%= t('Admin') %></a>
          <a href="/admin/timesheets" class="<%= path.startsWith('/admin/timesheets') ? 'active' : '' %>"><%= t('Timesheets') %></a>
        <% } %>
        <form method="post" action="/logout" class="inline">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button class="linklike"><%= t('Logout') %></button>
        </form>
      <% } %>
      <form method="get" action="/lang" class="lang-form">
        <input type="hidden" name="next" value="<%= currentUrl %>">
        <select name="code" aria-label="Language" onchange="this.form.submit()">
          <% Object.entries(LANGUAGES).forEach(([code, l]) => { %><option value="<%= code %>" <%= code === lang ? 'selected' : '' %>><%= l.name %></option><% }) %>
        </select>
        <noscript><button class="btn btn-sm">OK</button></noscript>
      </form>
    </nav>
  </div>
</header>
<main class="wrap">
<% if (flash) { %><div class="alert alert-<%= flash.type %>"><%= flash.message %></div><% } %>
