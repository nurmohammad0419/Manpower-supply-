<div class="row2">
  <label><%= t('Full name (as in Iqama/Passport)') %> * <input name="full_name" required value="<%= form.full_name || '' %>"></label>
  <label><%= t('Nationality') %> * <input name="nationality" required value="<%= form.nationality || '' %>" list="nationalities"></label>
</div>
<datalist id="nationalities"><% NATIONALITIES.forEach(n => { %><option value="<%= n %>"><%= t(n) %></option><% }) %></datalist>
<div class="row2">
  <label><%= t('Iqama number') %> <input name="iqama_number" value="<%= form.iqama_number || '' %>" inputmode="numeric" dir="ltr"></label>
  <label><%= t('Passport number') %> <input name="passport_number" value="<%= form.passport_number || '' %>" dir="ltr"></label>
</div>
<div class="row3">
  <label><%= t('Main profession') %> *
    <select name="profession" required>
      <option value=""><%= t('Choose…') %></option>
      <% CATEGORIES.forEach(c => { %><option value="<%= c %>" <%= form.profession === c ? 'selected' : '' %>><%= t(c) %></option><% }) %>
    </select>
  </label>
  <label><%= t('Experience (years)') %> <input type="number" min="0" max="60" name="experience_years" value="<%= form.experience_years || 0 %>"></label>
  <label><%= t('Current city') %>
    <select name="city">
      <option value=""><%= t('Choose…') %></option>
      <% CITIES.forEach(c => { %><option value="<%= c %>" <%= form.city === c ? 'selected' : '' %>><%= t(c) %></option><% }) %>
    </select>
  </label>
</div>
<% const pos = [].concat(form.positions || []); %>
<div class="label"><%= t('Other positions you can work as') %></div>
<p class="hint"><%= t('Choose all that apply. You get a message when a new job is posted for any of your positions.') %></p>
<div class="checks positions">
  <% CATEGORIES.forEach(c => { %>
    <label class="check"><input type="checkbox" name="positions" value="<%= c %>" <%= pos.includes(c) ? 'checked' : '' %>> <%= t(c) %></label>
  <% }) %>
</div>
<div class="row2">
  <label><%= t('Date of birth') %> <input type="date" name="date_of_birth" value="<%= form.date_of_birth || '' %>"></label>
  <label><%= t('Skills / languages') %> <input name="skills" value="<%= form.skills || '' %>" placeholder="<%= t('e.g. Shuttering, tiles; Arabic, Hindi') %>"></label>
</div>
