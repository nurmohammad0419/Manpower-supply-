<a class="demand-card" href="/demands/<%= d.id %>">
  <div class="dc-top">
    <span class="tag"><%= t(d.category) %></span>
    <span class="muted small"><%= t(d.location_city) %></span>
  </div>
  <h3><bdi><%= d.title %></bdi></h3>
  <div class="muted small company-line"><% if (d.show_company) { %><%- include('logo', { file: d.logo_file, size: 'sm' }) %><bdi><%= d.company_name %></bdi><% } else { %><%= t('Client company') %> · ManpowerHub KSA<% } %></div>
  <div class="rate"><strong><%= d.worker_rate ?? '—' %> <%= t('SAR') %></strong> <%= t(SALARY_TYPES[d.worker_rate_type] || '') %></div>
  <div class="dc-meta">
    <span><%= t('{n} workers', { n: d.quantity }) %></span>
    <span><%= t('{n} hrs/day', { n: d.hours_per_day }) %></span>
    <span><bdi><%= d.duration %></bdi></span>
  </div>
  <div class="dc-perks">
    <% if (d.local_transport) { %><span class="perk"><%= t('Transport') %></span><% } %>
    <% if (d.outside_accommodation) { %><span class="perk"><%= t('Accommodation') %></span><% } %>
    <% if (d.outside_food) { %><span class="perk"><%= t('Food') %></span><% } %>
  </div>
</a>
