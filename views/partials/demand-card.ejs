<a class="demand-card" href="/demands/<%= d.id %>">
  <div class="dc-top">
    <span class="tag"><%= t(d.category) %></span>
    <span class="muted small"><%= t(d.location_city) %></span>
  </div>
  <h3><bdi><%= d.title %></bdi></h3>
  <div class="muted small"><bdi><%= d.company_name %></bdi></div>
  <div class="rate"><strong><%= d.salary_amount %> <%= t('SAR') %></strong> <%= t(SALARY_TYPES[d.salary_type]) %></div>
  <div class="dc-meta">
    <span><%= t('{n} workers', { n: d.quantity }) %></span>
    <span><%= t('{n} hrs/day', { n: d.hours_per_day }) %></span>
    <span><bdi><%= d.duration %></bdi></span>
  </div>
  <div class="dc-perks">
    <% if (d.food !== 'no') { %><span class="perk"><%= t('Food') %></span><% } %>
    <% if (d.accommodation !== 'no') { %><span class="perk"><%= t('Accommodation') %></span><% } %>
    <% if (d.transport !== 'no') { %><span class="perk"><%= t('Transport') %></span><% } %>
  </div>
</a>
