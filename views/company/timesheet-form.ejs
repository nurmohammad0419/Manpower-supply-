<%- include('../partials/header') %>
<div class="crumbs"><a href="/company/timesheets"><span class="arr">←</span> <%= t('Timesheets') %></a></div>
<div class="card">
  <h1><%= t('Upload timesheet') %></h1>
  <p class="muted"><bdi><%= demand.title %></bdi> · <%= t('Rate') %>: <%= demand.salary_amount %> <%= t('SAR') %> <%= t(SALARY_TYPES[demand.salary_type]) %></p>
  <% if (locals.error) { %><div class="alert alert-error"><%= t(error) %></div><% } %>
  <% if (form.existing && form.existing.status === 'rejected') { %>
    <div class="alert alert-warn"><b><%= t('The admin asked for a correction') %>:</b> <bdi><%= form.existing.admin_note %></bdi></div>
  <% } else if (form.existing && form.existing.status === 'submitted') { %>
    <div class="alert alert-warn"><%= t('A timesheet for this month is already waiting for admin check. Saving replaces it.') %></div>
  <% } else if (form.existing) { %>
    <div class="alert alert-error"><%= t('A confirmed timesheet for this month already exists.') %></div>
  <% } %>
  <form method="post" action="/company/timesheets" enctype="multipart/form-data" id="ts-form" data-rate="<%= demand.salary_amount %>" data-type="<%= demand.salary_type %>">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <input type="hidden" name="demand_id" value="<%= demand.id %>">
    <div class="row3">
      <label><%= t('Month') %> * <input type="month" name="month" required value="<%= form.month || '' %>"></label>
      <label><%= t('Payment method') %> *
        <select name="payment_method" required>
          <% Object.entries(PAYMENT_METHODS).forEach(([k, v]) => { %><option value="<%= k %>" <%= form.payment_method === k ? 'selected' : '' %>><%= t(v) %></option><% }) %>
        </select>
      </label>
      <label><%= t('Timesheet file (PDF or Excel)') %> <%= form.existing ? '' : '*' %>
        <input type="file" name="file" accept=".pdf,.xlsx,.xls,.csv" <%= form.existing ? '' : 'required' %>>
        <span class="hint"><%= form.existing ? t('Leave empty to keep the file you uploaded before.') : t('PDF, Excel (.xlsx, .xls) or CSV, max 10 MB.') %></span>
      </label>
    </div>
    <h3><%= t('Hours and pay for each worker') %></h3>
    <p class="hint"><%= t('The amount is calculated from the rate; you can change it. Leave a worker empty if they did not work this month.') %></p>
    <div class="table-wrap bordered">
      <table class="table">
        <thead><tr><th><%= t('Worker') %></th><th><%= t('Days worked') %></th><th><%= t('Hours') %></th><th><%= t('Amount (SAR)') %></th></tr></thead>
        <tbody>
        <% workers.forEach(w => { %>
          <tr class="ts-row">
            <td><b><bdi><%= w.full_name %></bdi></b><div class="small muted"><%= t('Iqama No.') %> <%= w.iqama_number || '—' %></div></td>
            <td><input type="number" class="ts-days" name="days_<%= w.user_id %>" min="0" max="31" step="1" value="<%= form['days_' + w.user_id] ?? '' %>"></td>
            <td><input type="number" class="ts-hours" name="hours_<%= w.user_id %>" min="0" max="744" step="0.25" value="<%= form['hours_' + w.user_id] ?? '' %>"></td>
            <td><input type="number" class="ts-amount" name="amount_<%= w.user_id %>" min="0" step="0.01" value="<%= form['amount_' + w.user_id] ?? '' %>"></td>
          </tr>
        <% }) %>
        </tbody>
      </table>
    </div>
    <button class="btn full"><%= t('Submit for admin check') %></button>
  </form>
</div>
<script>
  (function () {
    var form = document.getElementById('ts-form');
    var rate = parseFloat(form.dataset.rate) || 0;
    var type = form.dataset.type;
    form.querySelectorAll('.ts-row').forEach(function (row) {
      var days = row.querySelector('.ts-days'), hours = row.querySelector('.ts-hours'), amount = row.querySelector('.ts-amount');
      if (amount.value) amount.dataset.touched = '1';
      amount.addEventListener('input', function () { amount.dataset.touched = '1'; });
      function update() {
        if (amount.dataset.touched) return;
        var d = parseFloat(days.value) || 0, h = parseFloat(hours.value) || 0, v = 0;
        if (type === 'hourly') v = h * rate;
        else if (type === 'daily') v = d * rate;
        else if (type === 'monthly') v = d ? Math.min(d, 30) / 30 * rate : 0;
        amount.value = v ? v.toFixed(2) : '';
      }
      days.addEventListener('input', update);
      hours.addEventListener('input', update);
    });
  })();
</script>
<%- include('../partials/footer') %>
