<%- include('../partials/header') %>
<% const req = a.required_docs.split(',').filter(Boolean); const have = new Set(documents.map(d => d.doc_type)); %>
<div class="crumbs"><a href="/company/demands/<%= a.demand_id %>">← <%= a.demand_title %></a></div>
<div class="detail">
  <div class="card">
    <h1><%= worker.full_name %></h1>
    <p>Status: <span class="badge badge-<%= a.status %>"><%= APP_STATUS[a.status] %></span></p>
    <table class="kv">
      <tr><th>Nationality</th><td><%= worker.nationality %></td></tr>
      <tr><th>Profession</th><td><%= worker.profession %> (<%= worker.experience_years %> years)</td></tr>
      <tr><th>Iqama No.</th><td><%= worker.iqama_number || '—' %></td></tr>
      <tr><th>Passport No.</th><td><%= worker.passport_number || '—' %></td></tr>
      <tr><th>Date of birth</th><td><%= worker.date_of_birth ? fmtDate(worker.date_of_birth) : '—' %></td></tr>
      <tr><th>City</th><td><%= worker.city || '—' %></td></tr>
      <tr><th>Skills</th><td><%= worker.skills || '—' %></td></tr>
      <tr><th>Phone</th><td><a href="tel:<%= worker.phone %>"><%= worker.phone %></a></td></tr>
      <tr><th>Email</th><td><a href="mailto:<%= worker.email %>"><%= worker.email %></a></td></tr>
    </table>
    <% if (a.cover_note) { %><h3>Message from worker</h3><p class="prewrap"><%= a.cover_note %></p><% } %>

    <h3>Documents</h3>
    <% req.forEach(d => { if (!have.has(d)) { %><div class="alert alert-warn">Missing required: <%= DOC_TYPES[d] %></div><% } }) %>
    <% if (!documents.length) { %><p class="muted">No documents uploaded.</p><% } %>
    <div class="docs">
      <% documents.forEach(d => { %>
        <a class="doc" href="/documents/<%= d.id %>" target="_blank">
          <% if (d.mime_type.startsWith('image/')) { %><img src="/documents/<%= d.id %>" alt=""><% } else { %><div class="pdf">PDF</div><% } %>
          <b><%= DOC_TYPES[d.doc_type] %></b><span class="small muted"><%= d.original_name %></span>
        </a>
      <% }) %>
    </div>
  </div>
  <aside class="card apply-box">
    <h2>Decision</h2>
    <% if (a.status === 'withdrawn') { %>
      <p class="muted">The worker withdrew this application.</p>
    <% } else { %>
    <form method="post" action="/company/applications/<%= a.id %>/status">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <label>Note to worker (optional)
        <textarea name="company_note" rows="3" maxlength="1000" placeholder="e.g. Report to site office on Sunday 7 AM"><%= a.company_note || '' %></textarea>
      </label>
      <button name="status" value="hired" class="btn full">Hire</button>
      <button name="status" value="shortlisted" class="btn btn-alt full">Shortlist</button>
      <button name="status" value="rejected" class="btn btn-danger full">Reject</button>
    </form>
    <% } %>
  </aside>
</div>
<%- include('../partials/footer') %>
