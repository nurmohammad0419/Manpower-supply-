<%- include('../partials/header') %>
<div class="section-head">
  <h1 class="company-line"><%- include('../partials/logo', { file: company.logo_file, size: 'lg' }) %><bdi><%= company.company_name %></bdi></h1>
  <a class="btn" href="/company/demands/new"><%= t('+ Post new demand') %></a>
</div>
<% if (company.status === 'pending') { %>
  <div class="alert alert-warn"><%= t('Your company is awaiting admin verification. You can post demands now; they will be visible to workers once approved.') %></div>
<% } else if (company.status === 'rejected') { %>
  <div class="alert alert-error"><%= t('Your company registration was not approved. Please contact support.') %></div>
<% } %>
<% if (!demands.length) { %>
  <div class="card empty"><%= t('You have not posted any demands yet.') %> <a href="/company/demands/new"><%= t('Post your first demand') %></a></div>
<% } else { %>
<div class="card table-wrap">
  <table class="table">
    <thead><tr><th><%= t('Demand') %></th><th><%= t('Your rate') %></th><th><%= t('Workers assigned') %></th><th><%= t('Admin review') %></th><th><%= t('Status') %></th><th></th></tr></thead>
    <tbody>
    <% demands.forEach(d => { %>
      <tr>
        <td><a href="/company/demands/<%= d.id %>"><b><bdi><%= d.title %></bdi></b></a><div class="small muted"><%= t(d.category) %> · <%= t(d.location_city) %> · <%= t('posted {date}', { date: fmtDate(d.created_at) }) %></div></td>
        <td><%= d.salary_amount %> <%= t('SAR') %> <span class="small muted"><%= t(SALARY_TYPES[d.salary_type]) %></span></td>
        <td><div class="progress"><span style="width:<%= Math.min(100, Math.round(d.hired_count / d.quantity * 100)) %>%"></span></div><span class="small"><%= d.hired_count %> / <%= d.quantity %></span></td>
        <td><%- include('../partials/review-badge', { status: d.review_status }) %></td>
        <td><span class="badge badge-<%= d.status === 'open' ? 'hired' : 'withdrawn' %>"><%= t(d.status === 'open' ? 'Open' : 'Closed') %></span></td>
        <td><a href="/company/demands/<%= d.id %>"><%= t('View') %> <span class="arr">→</span></a></td>
      </tr>
    <% }) %>
    </tbody>
  </table>
</div>
<% } %>
<%- include('../partials/footer') %>
