<%- include('../partials/header') %>
<div class="section-head">
  <h1><%= company.company_name %></h1>
  <a class="btn" href="/company/demands/new">+ Post new demand</a>
</div>
<% if (company.status === 'pending') { %>
  <div class="alert alert-warn">Your company is awaiting admin verification. You can post demands now; they will be visible to workers once approved.</div>
<% } else if (company.status === 'rejected') { %>
  <div class="alert alert-error">Your company registration was not approved. Please contact support.</div>
<% } %>
<% if (!demands.length) { %>
  <div class="card empty">You have not posted any demands yet. <a href="/company/demands/new">Post your first demand</a>.</div>
<% } else { %>
<div class="card table-wrap">
  <table class="table">
    <thead><tr><th>Demand</th><th>Rate</th><th>Filled</th><th>Applicants</th><th>Status</th><th></th></tr></thead>
    <tbody>
    <% demands.forEach(d => { %>
      <tr>
        <td><a href="/company/demands/<%= d.id %>"><b><%= d.title %></b></a><div class="small muted"><%= d.category %> · <%= d.location_city %> · posted <%= fmtDate(d.created_at) %></div></td>
        <td><%= d.salary_amount %> SAR <span class="small muted"><%= SALARY_TYPES[d.salary_type] %></span></td>
        <td><div class="progress"><span style="width:<%= Math.min(100, Math.round(d.hired_count / d.quantity * 100)) %>%"></span></div><span class="small"><%= d.hired_count %> / <%= d.quantity %></span></td>
        <td><%= d.applicant_count %> <% if (d.new_count) { %><span class="badge badge-applied"><%= d.new_count %> new</span><% } %></td>
        <td><span class="badge badge-<%= d.status === 'open' ? 'hired' : 'withdrawn' %>"><%= d.status %></span></td>
        <td><a href="/company/demands/<%= d.id %>">Manage →</a></td>
      </tr>
    <% }) %>
    </tbody>
  </table>
</div>
<% } %>
<%- include('../partials/footer') %>
