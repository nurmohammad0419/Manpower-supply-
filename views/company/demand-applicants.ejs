<%- include('../partials/header') %>
<div class="crumbs"><a href="/company"><span class="arr">←</span> <%= t('Dashboard') %></a></div>
<div class="section-head">
  <div>
    <h1><bdi><%= demand.title %></bdi></h1>
    <p class="muted"><%= t(demand.category) %> · <%= t(demand.location_city) %> · <%= demand.salary_amount %> <%= t('SAR') %> <%= t(SALARY_TYPES[demand.salary_type]) %> · <%= t('{n} hrs/day', { n: demand.hours_per_day }) %></p>
  </div>
  <div class="actions">
    <a class="btn btn-alt" href="/demands/<%= demand.id %>"><%= t('View public page') %></a>
    <a class="btn btn-alt" href="/demands/<%= demand.id %>/letter" target="_blank"><%= t('Demand letter') %></a>
    <a class="btn btn-alt" href="/company/demands/<%= demand.id %>/edit"><%= t('Edit') %></a>
    <form method="post" action="/company/demands/<%= demand.id %>/status" class="inline">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <input type="hidden" name="status" value="<%= demand.status === 'open' ? 'closed' : 'open' %>">
      <button class="btn <%= demand.status === 'open' ? 'btn-danger' : '' %>"><%= demand.status === 'open' ? t('Close demand') : t('Re-open') %></button>
    </form>
  </div>
</div>
<% if (demand.company_status !== 'approved') { %><div class="alert alert-warn"><%= t('Not yet visible to workers — your company is awaiting verification.') %></div><% } %>

<div class="stats stats-row">
  <div class="stat"><b><%= demand.hired_count %> / <%= demand.quantity %></b><span><%= t('Hired') %></span></div>
  <div class="stat"><b><%= counts.shortlisted || 0 %></b><span><%= t('Shortlisted') %></span></div>
  <div class="stat"><b><%= counts.applied || 0 %></b><span><%= t('New') %></span></div>
  <div class="stat"><b><%= counts.rejected || 0 %></b><span><%= t('Rejected') %></span></div>
</div>

<div class="tabs">
  <a href="?" class="<%= !filter ? 'active' : '' %>"><%= t('All') %></a>
  <% ['applied','shortlisted','hired','rejected'].forEach(s => { %><a href="?status=<%= s %>" class="<%= filter === s ? 'active' : '' %>"><%= t(APP_STATUS[s]) %></a><% }) %>
</div>

<% if (!applications.length) { %>
  <div class="card empty"><%= t('No applicants here yet.') %></div>
<% } else { %>
<div class="card table-wrap">
  <table class="table">
    <thead><tr><th><%= t('Worker') %></th><th><%= t('Profession') %></th><th><%= t('Contact') %></th><th><%= t('Applied') %></th><th><%= t('Status') %></th><th><%= t('Action') %></th></tr></thead>
    <tbody>
    <% applications.forEach(a => { %>
      <tr>
        <td><a href="/company/applications/<%= a.id %>"><b><bdi><%= a.full_name %></bdi></b></a><div class="small muted"><%= t(a.nationality) %><%= a.city ? ' · ' + t(a.city) : '' %></div></td>
        <td><%= t(a.profession) %><div class="small muted"><%= t('{n} yrs exp.', { n: a.experience_years }) %></div></td>
        <td class="small" dir="ltr"><%= a.phone %><br><%= a.email %></td>
        <td class="small"><%= fmtDate(a.created_at) %></td>
        <td><span class="badge badge-<%= a.status %>"><%= t(APP_STATUS[a.status]) %></span></td>
        <td class="nowrap">
          <a href="/company/applications/<%= a.id %>"><%= t('Documents') %></a>
          <% if (a.status !== 'withdrawn') { %>
          <form method="post" action="/company/applications/<%= a.id %>/status" class="inline quick">
            <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="back" value="list">
            <% if (a.status === 'applied') { %><button name="status" value="shortlisted" class="btn btn-sm btn-alt"><%= t('Shortlist') %></button><% } %>
            <% if (a.status !== 'hired') { %><button name="status" value="hired" class="btn btn-sm"><%= t('Hire') %></button><% } %>
            <% if (a.status !== 'rejected' && a.status !== 'hired') { %><button name="status" value="rejected" class="btn btn-sm btn-danger"><%= t('Reject') %></button><% } %>
          </form>
          <% } %>
        </td>
      </tr>
    <% }) %>
    </tbody>
  </table>
</div>
<% } %>
<%- include('../partials/footer') %>
