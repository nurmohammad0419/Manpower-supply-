<%- include('../partials/header') %>
<div class="crumbs"><a href="/company">← Dashboard</a></div>
<div class="section-head">
  <div>
    <h1><%= demand.title %></h1>
    <p class="muted"><%= demand.category %> · <%= demand.location_city %> · <%= demand.salary_amount %> SAR <%= SALARY_TYPES[demand.salary_type] %> · <%= demand.hours_per_day %> hrs/day</p>
  </div>
  <div class="actions">
    <a class="btn btn-alt" href="/demands/<%= demand.id %>">View public page</a>
    <a class="btn btn-alt" href="/demands/<%= demand.id %>/letter" target="_blank">Demand letter</a>
    <a class="btn btn-alt" href="/company/demands/<%= demand.id %>/edit">Edit</a>
    <form method="post" action="/company/demands/<%= demand.id %>/status" class="inline">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <input type="hidden" name="status" value="<%= demand.status === 'open' ? 'closed' : 'open' %>">
      <button class="btn <%= demand.status === 'open' ? 'btn-danger' : '' %>"><%= demand.status === 'open' ? 'Close demand' : 'Re-open' %></button>
    </form>
  </div>
</div>
<% if (demand.company_status !== 'approved') { %><div class="alert alert-warn">Not yet visible to workers — your company is awaiting verification.</div><% } %>

<div class="stats stats-row">
  <div class="stat"><b><%= demand.hired_count %> / <%= demand.quantity %></b><span>Hired</span></div>
  <div class="stat"><b><%= counts.shortlisted || 0 %></b><span>Shortlisted</span></div>
  <div class="stat"><b><%= counts.applied || 0 %></b><span>New</span></div>
  <div class="stat"><b><%= counts.rejected || 0 %></b><span>Rejected</span></div>
</div>

<div class="tabs">
  <a href="?" class="<%= !filter ? 'active' : '' %>">All</a>
  <% ['applied','shortlisted','hired','rejected'].forEach(s => { %><a href="?status=<%= s %>" class="<%= filter === s ? 'active' : '' %>"><%= APP_STATUS[s] %></a><% }) %>
</div>

<% if (!applications.length) { %>
  <div class="card empty">No applicants here yet.</div>
<% } else { %>
<div class="card table-wrap">
  <table class="table">
    <thead><tr><th>Worker</th><th>Profession</th><th>Contact</th><th>Applied</th><th>Status</th><th>Action</th></tr></thead>
    <tbody>
    <% applications.forEach(a => { %>
      <tr>
        <td><a href="/company/applications/<%= a.id %>"><b><%= a.full_name %></b></a><div class="small muted"><%= a.nationality %><%= a.city ? ' · ' + a.city : '' %></div></td>
        <td><%= a.profession %><div class="small muted"><%= a.experience_years %> yrs exp.</div></td>
        <td class="small"><%= a.phone %><br><%= a.email %></td>
        <td class="small"><%= fmtDate(a.created_at) %></td>
        <td><span class="badge badge-<%= a.status %>"><%= APP_STATUS[a.status] %></span></td>
        <td class="nowrap">
          <a href="/company/applications/<%= a.id %>">Documents</a>
          <% if (a.status !== 'withdrawn') { %>
          <form method="post" action="/company/applications/<%= a.id %>/status" class="inline quick">
            <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="back" value="list">
            <% if (a.status === 'applied') { %><button name="status" value="shortlisted" class="btn btn-sm btn-alt">Shortlist</button><% } %>
            <% if (a.status !== 'hired') { %><button name="status" value="hired" class="btn btn-sm">Hire</button><% } %>
            <% if (a.status !== 'rejected' && a.status !== 'hired') { %><button name="status" value="rejected" class="btn btn-sm btn-danger">Reject</button><% } %>
          </form>
          <% } %>
        </td>
      </tr>
    <% }) %>
    </tbody>
  </table>
</div>
<% } %>
<%- include('../partials/footer') %>
