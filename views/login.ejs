<%- include('partials/header') %>
<div class="card narrow">
  <h1><%= t('Login') %></h1>
  <% if (locals.error) { %><div class="alert alert-error"><%= t(error) %></div><% } %>
  <form method="post" action="/login">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <input type="hidden" name="next" value="<%= next %>">
    <label><%= t('Email') %> <input type="email" name="email" required value="<%= locals.email || '' %>" autocomplete="email" dir="ltr"></label>
    <label><%= t('Password') %> <input type="password" name="password" required autocomplete="current-password" dir="ltr"></label>
    <button class="btn full"><%= t('Login') %></button>
  </form>
  <p class="muted center"><%= t('No account?') %> <a href="/register"><%= t('Register') %></a></p>
</div>
<%- include('partials/footer') %>
