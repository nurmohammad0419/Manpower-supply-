<%- include('partials/header') %>
<h1>Job Demands</h1>
<form class="filters card" method="get" action="/demands">
  <input type="search" name="q" value="<%= filters.q %>" placeholder="Search job, company, keyword…">
  <select name="category">
    <option value="">All categories</option>
    <% CATEGORIES.forEach(c => { %><option <%= filters.category === c ? 'selected' : '' %>><%= c %></option><% }) %>
  </select>
  <select name="city">
    <option value="">All cities</option>
    <% CITIES.forEach(c => { %><option <%= filters.city === c ? 'selected' : '' %>><%= c %></option><% }) %>
  </select>
  <button class="btn">Search</button>
</form>
<p class="muted"><%= demands.length %> open demand(s)</p>
<% if (!demands.length) { %>
  <div class="card empty">No demands match your search.</div>
<% } else { %>
  <div class="grid"><% demands.forEach(d => { %><%- include('partials/demand-card', { d }) %><% }) %></div>
<% } %>
<%- include('partials/footer') %>
