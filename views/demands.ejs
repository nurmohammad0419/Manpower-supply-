<%- include('partials/header') %>
<h1><%= t('Job Demands') %></h1>
<form class="filters card" method="get" action="/demands">
  <input type="search" name="q" value="<%= filters.q %>" placeholder="<%= t('Search job, company, keyword…') %>">
  <select name="category">
    <option value=""><%= t('All categories') %></option>
    <% CATEGORIES.forEach(c => { %><option value="<%= c %>" <%= filters.category === c ? 'selected' : '' %>><%= t(c) %></option><% }) %>
  </select>
  <select name="city">
    <option value=""><%= t('All cities') %></option>
    <% CITIES.forEach(c => { %><option value="<%= c %>" <%= filters.city === c ? 'selected' : '' %>><%= t(c) %></option><% }) %>
  </select>
  <button class="btn"><%= t('Search') %></button>
</form>
<p class="muted"><%= t('{n} open demand(s)', { n: demands.length }) %></p>
<% if (!demands.length) { %>
  <div class="card empty"><%= t('No demands match your search.') %></div>
<% } else { %>
  <div class="grid"><% demands.forEach(d => { %><%- include('partials/demand-card', { d }) %><% }) %></div>
<% } %>
<%- include('partials/footer') %>
