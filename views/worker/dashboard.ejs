<%- include('../partials/header') %>
<% const essentials = ['iqama','passport','photo','cv']; const missing = essentials.filter(d => !docTypes.includes(d)); %>
<h1><%= t('Hello, {name}', { name: worker.full_name }) %></h1>
<% if (missing.length) { %>
  <div class="alert alert-warn"><%= t('Complete your profile to apply faster — missing: {docs}.', { docs: missing.map(m => t(DOC_TYPES[m])).join(', ') }) %> <a href="/worker/documents"><%= t('Upload now') %> <span class="arr">→</span></a></div>
<% } %>

<h2><%= t('My applications') %></h2>
<% if (!applications.length) { %>
  <div class="card empty"><%= t('You have not applied to any job yet.') %> <a href="/demands"><%= t('Browse demands') %> <span class="arr">→</span></a></div>
<% } else { %>
<div class="card table-wrap">
  <table class="table">
    <thead><tr><th><%= t('Job') %></th><th><%= t('Rate') %></th><th><%= t('Status') %></th><th><%= t('Updated') %></th><th></th></tr></thead>
    <tbody>
    <% applications.forEach(a => { %>
      <tr>
        <td><a href="/demands/<%= a.demand_id %>"><b><bdi><%= a.title %></bdi></b></a><div class="small muted"><bdi><%= a.company_name %></bdi> · <%= t(a.location_city) %></div>
          <% if (a.company_note && a.status !== 'withdrawn') { %><div class="note">💬 <bdi><%= a.company_note %></bdi></div><% } %></td>
        <td><%= a.salary_amount %> <%= t('SAR') %> <span class="small muted"><%= t(SALARY_TYPES[a.salary_type]) %></span></td>
        <td><span class="badge badge-<%= a.status %>"><%= t(APP_STATUS[a.status]) %></span></td>
        <td class="small"><%= fmtDate(a.updated_at) %></td>
        <td>
          <% if (['applied','shortlisted'].includes(a.status)) { %>
          <form method="post" action="/worker/applications/<%= a.id %>/withdraw" class="inline" data-confirm="<%= t('Withdraw this application?') %>" onsubmit="return confirm(this.dataset.confirm)">
            <input type="hidden" name="_csrf" value="<%= csrf %>"><button class="linklike danger"><%= t('Withdraw') %></button>
          </form>
          <% } %>
        </td>
      </tr>
    <% }) %>
    </tbody>
  </table>
</div>
<% } %>

<div class="section-head"><h2><%= t('Jobs you may like') %></h2><a href="/demands"><%= t('All demands') %> <span class="arr">→</span></a></div>
<% if (!recommended.length) { %>
  <div class="card empty"><%= t('No new demands right now. Check back soon.') %></div>
<% } else { %>
  <div class="grid"><% recommended.forEach(d => { %><%- include('../partials/demand-card', { d }) %><% }) %></div>
<% } %>
<%- include('../partials/footer') %>
