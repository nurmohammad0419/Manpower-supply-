<%- include('partials/header') %>
<div class="card medium">
  <h1>Worker registration</h1>
  <p class="muted">Free for workers. After registering, upload your documents once and apply to any job.</p>
  <% if (locals.error) { %><div class="alert alert-error"><%= error %></div><% } %>
  <form method="post" action="/register/worker">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <fieldset><legend>Personal details</legend><%- include('partials/worker-fields') %></fieldset>
    <%- include('partials/account-fields') %>
    <button class="btn full">Register</button>
  </form>
</div>
<%- include('partials/footer') %>
