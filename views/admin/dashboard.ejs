<%- include('../partials/header') %>
<% const cStatus = { approved: 'Approved', rejected: 'Rejected', pending: 'Pending' }; %>
<div class="section-head">
  <h1><%= t('Admin panel') %></h1>
  <a class="btn btn-alt" href="/admin/fields"><%= t('Worker profile fields') %></a>
</div>
<div class="stats stats-row">
  <div class="stat"><b><%= stats.companies %></b><span><%= t('Companies') %></span></div>
  <div class="stat"><b><%= stats.pending %></b><span><%= t('Pending approval') %></span></div>
  <div class="stat"><b><%= stats.workers %></b><span><%= t('Workers') %></span></div>
  <div class="stat"><b><%= stats.demands %></b><span><%= t('Open demands') %></span></div>
  <div class="stat"><b><%= stats.applications %></b><span><%= t('Applications') %></span></div>
  <div class="stat"><b><%= stats.hired %></b><span><%= t('Hired') %></span></div>
  <a class="stat stat-link" href="/admin/demands?review=pending"><b><%= stats.toReview %></b><span><%= t('Demands to review') %></span></a>
  <a class="stat stat-link" href="/admin/timesheets?status=submitted"><b><%= stats.timesheets %></b><span><%= t('Timesheets to check') %></span></a>
</div>

<h2><%= t('Companies') %></h2>
<div class="card table-wrap">
  <table class="table">
    <thead><tr><th><%= t('Company') %></th><th><%= t('CR No.') %></th><th><%= t('Contact') %></th><th><%= t('Demands') %></th><th><%= t('Status') %></th><th><%= t('Action') %></th></tr></thead>
    <tbody>
    <% if (!companies.length) { %><tr><td colspan="6" class="muted"><%= t('No companies yet.') %></td></tr><% } %>
    <% companies.forEach(c => { %>
      <tr>
        <td><b><bdi><%= c.company_name %></bdi></b><div class="small muted"><%= t(c.city) %> · <%= t('joined {date}', { date: fmtDate(c.created_at) }) %></div></td>
        <td><%= c.cr_number %></td>
        <td class="small"><bdi><%= c.contact_person %></bdi><br><span dir="ltr"><%= c.phone %></span><br><%= c.email %></td>
        <td><%= c.demand_count %></td>
        <td><span class="badge badge-<%= c.status === 'approved' ? 'hired' : c.status === 'rejected' ? 'rejected' : 'applied' %>"><%= t(cStatus[c.status]) %></span></td>
        <td class="nowrap">
          <form method="post" action="/admin/companies/<%= c.user_id %>/status" class="inline">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <% if (c.status !== 'approved') { %><button name="status" value="approved" class="btn btn-sm"><%= t('Approve') %></button><% } %>
            <% if (c.status !== 'rejected') { %><button name="status" value="rejected" class="btn btn-sm btn-danger"><%= t('Reject') %></button><% } %>
          </form>
        </td>
      </tr>
    <% }) %>
    </tbody>
  </table>
</div>

<h2><%= t('Demands') %></h2>
<div class="card table-wrap">
  <table class="table">
    <thead><tr><th><%= t('Demand') %></th><th><%= t('Company') %></th><th><%= t('Rate') %></th><th><%= t('Filled') %></th><th><%= t('Applicants') %></th><th><%= t('Status') %></th></tr></thead>
    <tbody>
    <% if (!demands.length) { %><tr><td colspan="6" class="muted"><%= t('No demands yet.') %></td></tr><% } %>
    <% demands.forEach(d => { %>
      <tr>
        <td><a href="/admin/demands/<%= d.id %>"><bdi><%= d.title %></bdi></a><div class="small muted"><%= t(d.category) %> · <%= t(d.location_city) %></div></td>
        <td><bdi><%= d.company_name %></bdi></td>
        <td><%= d.salary_amount %> <%= t('SAR') %> <span class="small muted"><%= t(SALARY_TYPES[d.salary_type]) %></span></td>
        <td><%= d.hired_count %> / <%= d.quantity %></td>
        <td><%= d.applicant_count %></td>
        <td><%= t(d.status === 'open' ? 'Open' : 'Closed') %></td>
      </tr>
    <% }) %>
    </tbody>
  </table>
</div>

<h2><%= t('Workers') %></h2>
<div class="card table-wrap">
  <table class="table">
    <thead><tr><th><%= t('Name') %></th><th><%= t('Profession') %></th><th><%= t('Contact') %></th><th><%= t('Documents') %></th><th><%= t('Applications') %></th></tr></thead>
    <tbody>
    <% if (!workers.length) { %><tr><td colspan="5" class="muted"><%= t('No workers yet.') %></td></tr><% } %>
    <% workers.forEach(w => { %>
      <tr>
        <td><a href="/admin/workers/<%= w.user_id %>"><b><bdi><%= w.full_name %></bdi></b></a><div class="small muted"><%= t(w.nationality) %> · <%= t('Iqama No.') %> <%= w.iqama_number || '—' %></div></td>
        <td><%= t(w.profession) %> <span class="small muted">(<%= t('{n} years', { n: w.experience_years }) %>)</span></td>
        <td class="small"><span dir="ltr"><%= w.phone %></span><br><%= w.email %></td>
        <td><%= w.doc_count %></td>
        <td><%= w.app_count %></td>
      </tr>
    <% }) %>
    </tbody>
  </table>
</div>
<h2><%= t('WhatsApp / SMS messages') %></h2>
<div class="card table-wrap">
  <table class="table">
    <thead><tr><th><%= t('Date') %></th><th><%= t('To') %></th><th><%= t('Message') %></th><th><%= t('Status') %></th></tr></thead>
    <tbody>
    <% if (!notifications.length) { %><tr><td colspan="4" class="muted"><%= t('No messages yet.') %></td></tr><% } %>
    <% const nStatus = { sent: 'Sent', failed: 'Failed', not_sent: 'Not sent', pending: 'Sending' }; %>
    <% notifications.forEach(n => { %>
      <tr>
        <td class="small nowrap"><%= fmtDate(n.created_at) %></td>
        <td class="small"><bdi><%= n.name || '—' %></bdi><br><span dir="ltr"><%= n.recipient %></span> · <%= n.channel === 'sms' ? 'SMS' : 'WhatsApp' %></td>
        <td class="small prewrap" dir="auto"><%= n.body %></td>
        <td><span class="badge badge-<%= n.status === 'sent' ? 'hired' : n.status === 'failed' ? 'rejected' : 'withdrawn' %>"><%= t(nStatus[n.status]) %></span>
          <% if (n.error) { %><div class="small muted"><%= n.error %></div><% } %></td>
      </tr>
    <% }) %>
    </tbody>
  </table>
</div>
<%- include('../partials/footer') %>
