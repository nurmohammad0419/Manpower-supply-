<%- include('../partials/header') %>
<div class="crumbs"><a href="/admin"><span class="arr">←</span> <%= t('Admin') %></a></div>
<div class="card">
  <h1><bdi><%= worker.full_name %></bdi></h1>
  <table class="kv">
    <tr><th><%= t('Nationality') %></th><td><%= t(worker.nationality) %></td></tr>
    <tr><th><%= t('Profession') %></th><td><%= t(worker.profession) %> (<%= t('{n} years', { n: worker.experience_years }) %>)</td></tr>
    <tr><th><%= t('Iqama No.') %></th><td><%= worker.iqama_number || '—' %></td></tr>
    <tr><th><%= t('Passport No.') %></th><td><%= worker.passport_number || '—' %></td></tr>
    <tr><th><%= t('Phone') %> / <%= t('Email') %></th><td dir="ltr"><%= worker.phone %> · <%= worker.email %></td></tr>
  </table>
  <h3><%= t('Documents') %></h3>
  <div class="docs">
    <% documents.forEach(d => { %>
      <a class="doc" href="/documents/<%= d.id %>" target="_blank">
        <% if (d.mime_type.startsWith('image/')) { %><img src="/documents/<%= d.id %>" alt=""><% } else { %><div class="pdf">PDF</div><% } %>
        <b><%= t(DOC_TYPES[d.doc_type]) %></b><span class="small muted"><bdi><%= d.original_name %></bdi></span>
      </a>
    <% }) %>
    <% if (!documents.length) { %><p class="muted"><%= t('No documents uploaded.') %></p><% } %>
  </div>
</div>
<%- include('../partials/footer') %>
