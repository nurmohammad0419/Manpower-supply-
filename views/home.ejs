<%- include('partials/header') %>
<section class="hero">
  <div>
    <h1><%= t('Hire workers in Saudi Arabia — fully digital.') %></h1>
    <p class="lead"><%= t('Companies post manpower demands online. Workers see the rate, hours and conditions, apply with their documents, and get hired — no paper demand letters, no running between suppliers.') %></p>
    <div class="hero-actions">
      <a class="btn btn-lg" href="/register/company"><%= t('I need workers (Company)') %></a>
      <a class="btn btn-lg btn-alt" href="/register/worker"><%= t('I want a job (Worker)') %></a>
    </div>
  </div>
  <div class="stats">
    <div class="stat"><b><%= stats.openDemands %></b><span><%= t('Open demands') %></span></div>
    <div class="stat"><b><%= stats.positions %></b><span><%= t('Positions') %></span></div>
    <div class="stat"><b><%= stats.companies %></b><span><%= t('Verified companies') %></span></div>
    <div class="stat"><b><%= stats.workers %></b><span><%= t('Registered workers') %></span></div>
  </div>
</section>

<section class="how">
  <div class="card">
    <h2><%= t('For companies') %></h2>
    <ol>
      <li><%= t('Register your company once (CR number, contact).') %></li>
      <li><%= t('Post a demand with your rate, payment terms and facilities.') %></li>
      <li><%= t('ManpowerHub KSA signs an agreement with you and supplies checked workers.') %></li>
      <li><%= t('Submit monthly timesheets online and track your payments.') %></li>
    </ol>
  </div>
  <div class="card">
    <h2><%= t('For workers') %></h2>
    <ol>
      <li><%= t('Register and upload your Iqama, Passport, Photo and CV once.') %></li>
      <li><%= t('After approval, see all running jobs here — no more going from supplier to supplier.') %></li>
      <li><%= t('Get a WhatsApp / SMS message as soon as a job for your position is posted.') %></li>
      <li><%= t('Apply online; your salary and payment slip come from ManpowerHub KSA.') %></li>
    </ol>
  </div>
</section>

<% if (canSeeJobs) { %>
<div class="section-head">
  <h2><%= t('Latest demands') %></h2>
  <a href="/demands"><%= t('See all') %> <span class="arr">→</span></a>
</div>
<% if (!latest.length) { %>
  <div class="card empty"><%= t('No open demands yet.') %></div>
<% } else { %>
  <div class="grid"><% latest.forEach(d => { %><%- include('partials/demand-card', { d }) %><% }) %></div>
<% } %>
<% } else { %>
<div class="card jobs-locked">
  <div class="lock-icon">🔒</div>
  <div>
    <h2><%= t('Running jobs are only for registered workers') %></h2>
    <% if (workerStatus === 'pending') { %>
      <p class="muted"><%= t('Your account is waiting for approval. You can see jobs after ManpowerHub KSA approves it.') %></p>
    <% } else if (user && user.role === 'company') { %>
      <p class="muted"><%= t('Job posts are only visible to approved workers.') %></p>
    <% } else { %>
      <p class="muted"><%= t('Register as a worker. After ManpowerHub KSA approves your account you can see all jobs, and we message you when a new job for your position is posted.') %></p>
      <a class="btn" href="/register/worker"><%= t('Register as worker') %></a> <a class="btn btn-alt" href="/login"><%= t('Login') %></a>
    <% } %>
  </div>
</div>
<% } %>
<%- include('partials/footer') %>
